<Window x:Class="PrintDesktopClient.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        xmlns:tb="http://www.hardcodet.net/taskbar"
        xmlns:local="clr-namespace:PrintDesktopClient"
        xmlns:vm="clr-namespace:PrintDesktopClient.ViewModels"
        xmlns:services="clr-namespace:PrintDesktopClient.Services"
        xmlns:sys="clr-namespace:System;assembly=mscorlib"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance Type=vm:MainViewModel}"
        Title="Auto-Print Agent" Height="750" Width="980"
        Icon="/Resources/Images/PDC_Icons/favicon.ico"
        TextElement.Foreground="{DynamicResource MaterialDesignBody}"
        TextElement.FontWeight="Regular"
        TextElement.FontSize="14"
        TextOptions.TextFormattingMode="Ideal"
        TextOptions.TextRenderingMode="Auto"
        Background="{DynamicResource MaterialDesignPaper}"
        FontFamily="{materialDesign:MaterialDesignFont}"
        StateChanged="Window_StateChanged">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>
        <ObjectDataProvider x:Key="MarginModeValues"
                            MethodName="GetValues"
                            ObjectType="{x:Type sys:Enum}">
            <ObjectDataProvider.MethodParameters>
                <x:Type TypeName="services:MarginMode"/>
            </ObjectDataProvider.MethodParameters>
        </ObjectDataProvider>
    </Window.Resources>
    <Grid>
        <!-- Tray Icon -->
        <tb:TaskbarIcon x:Name="MyNotifyIcon"
                        Visibility="Visible"
                        ToolTipText="Auto-Print Agent"
                        IconSource="/Resources/Images/PDC_Icons/favicon.ico"
                        TrayMouseDoubleClick="MyNotifyIcon_TrayMouseDoubleClick">
            <tb:TaskbarIcon.ContextMenu>
                <ContextMenu>
                    <MenuItem Header="Open Dashboard" Click="Open_Click">
                        <MenuItem.Icon><materialDesign:PackIcon Kind="WindowMaximize"/></MenuItem.Icon>
                    </MenuItem>
                    <MenuItem Header="Sync Printers" Click="SyncPrinters_Click">
                        <MenuItem.Icon><materialDesign:PackIcon Kind="Sync"/></MenuItem.Icon>
                    </MenuItem>
                    <Separator/>
                    <MenuItem Header="About" Click="About_Click">
                        <MenuItem.Icon><materialDesign:PackIcon Kind="InformationOutline"/></MenuItem.Icon>
                    </MenuItem>
                    <Separator/>
                    <MenuItem Header="Exit" Click="Exit_Click">
                        <MenuItem.Icon><materialDesign:PackIcon Kind="ExitToApp"/></MenuItem.Icon>
                    </MenuItem>
                </ContextMenu>
            </tb:TaskbarIcon.ContextMenu>
        </tb:TaskbarIcon>

        <TabControl Style="{StaticResource MaterialDesignNavigationRailTabControl}" TabStripPlacement="Left"
                    SelectionChanged="TabControl_SelectionChanged">

            <!-- ═══════════════════════════ DASHBOARD ═══════════════════════════ -->
            <TabItem>
                <TabItem.Header>
                    <StackPanel>
                        <materialDesign:PackIcon Kind="ViewDashboard" HorizontalAlignment="Center" Width="24" Height="24"/>
                        <TextBlock Text="Dashboard" HorizontalAlignment="Center" FontSize="10"/>
                    </StackPanel>
                </TabItem.Header>
                <Grid Margin="20">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/> <!-- Header Logo Row -->
                        <RowDefinition Height="Auto"/> <!-- Printer Row -->
                        <RowDefinition Height="*"/>    <!-- Drop Zone -->
                        <RowDefinition Height="210"/>  <!-- Logs -->
                        <RowDefinition Height="Auto"/> <!-- Status Bar -->
                    </Grid.RowDefinitions>

                    <!-- Header Logo -->
                    <Grid Grid.Row="0" Margin="0,0,0,15">
                        <Image Source="/Resources/Images/full_logo.png" Height="40" HorizontalAlignment="Left" Margin="5,0,0,0"/>
                    </Grid>

                    <!-- Printer Row -->
                    <materialDesign:Card Grid.Row="1" Padding="15" Margin="0,0,0,15" materialDesign:ElevationAssist.Elevation="Dp2">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="Printer" VerticalAlignment="Center" Margin="0,0,10,0" Width="24" Height="24" Foreground="{DynamicResource PrimaryHueMidBrush}"/>
                            <TextBlock Text="Target Printer:" VerticalAlignment="Center" FontWeight="Bold" Margin="0,0,15,0"/>
                            <ComboBox ItemsSource="{Binding AvailablePrinters}"
                                      SelectedItem="{Binding SelectedPrinter}"
                                      materialDesign:HintAssist.Hint="Select a printer"
                                      Width="320" Margin="0,0,15,0"
                                      Style="{StaticResource MaterialDesignOutlinedComboBox}"/>
                            <Button Content="REFRESH" Command="{Binding RefreshPrintersCommand}" Style="{StaticResource MaterialDesignFlatButton}" Foreground="{DynamicResource PrimaryHueMidBrush}" Margin="0,0,10,0"/>
                            <Button Content="SYNC TO CLOUD" Command="{Binding SyncPrintersCommand}" Style="{StaticResource MaterialDesignOutlinedButton}"/>
                        </StackPanel>
                    </materialDesign:Card>

                    <!-- Drop Zone -->
                    <materialDesign:Card Grid.Row="2" Margin="0,0,0,15" materialDesign:ElevationAssist.Elevation="Dp1" UniformCornerRadius="8"
                                         AllowDrop="True" Drop="DropZone_Drop">
                        <Border BorderThickness="1" BorderBrush="{DynamicResource PrimaryHueMidBrush}" CornerRadius="8">
                            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                                <materialDesign:PackIcon Kind="CloudUpload" Width="64" Height="64" HorizontalAlignment="Center" Foreground="{DynamicResource PrimaryHueMidBrush}"/>
                                <TextBlock Text="Drag and drop documents here to print" FontSize="20" FontWeight="Light" Margin="0,15,0,5"/>
                                <TextBlock Text="PDF, Image, or Text files are supported" FontSize="14" Opacity="0.6" HorizontalAlignment="Center" Margin="0,0,0,25"/>
                                <Button Content="BROWSE FILES" Command="{Binding BrowseAndPrintCommand}"
                                        Style="{StaticResource MaterialDesignRaisedButton}" Width="180" Height="45"
                                        materialDesign:ButtonAssist.CornerRadius="22"/>
                            </StackPanel>
                        </Border>
                    </materialDesign:Card>

                    <!-- Logs -->
                    <materialDesign:Card Grid.Row="3" Padding="10" Margin="0,0,0,10" materialDesign:ElevationAssist.Elevation="Dp1">
                        <DockPanel>
                            <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,8">
                                <materialDesign:PackIcon Kind="ViewList" VerticalAlignment="Center" Margin="0,0,8,0" Foreground="{DynamicResource PrimaryHueMidBrush}"/>
                                <TextBlock Text="SYSTEM ACTIVITY LOG" FontWeight="Bold" FontSize="12" Foreground="{DynamicResource PrimaryHueMidBrush}"/>
                            </StackPanel>
                            <ListBox ItemsSource="{Binding Logs}" BorderThickness="0" Background="Transparent" ScrollViewer.VerticalScrollBarVisibility="Auto">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="0,2">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <materialDesign:PackIcon Kind="ChevronRight" VerticalAlignment="Center" Opacity="0.5" Width="14" Height="14" Margin="0,0,6,0"/>
                                            <TextBlock Grid.Column="1" Text="{Binding}" FontSize="11" FontFamily="Consolas" VerticalAlignment="Center"/>
                                        </Grid>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </DockPanel>
                    </materialDesign:Card>

                    <!-- Status Bar -->
                    <Grid Grid.Row="4" Margin="5,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="AccessPointNetwork" VerticalAlignment="Center" Margin="0,0,8,0" Foreground="{DynamicResource PrimaryHueMidBrush}"/>
                            <TextBlock Text="Active Connections (MQTT):" VerticalAlignment="Center" Opacity="0.7" Margin="0,0,5,0"/>
                            <TextBlock Text="{Binding MqttStatus}" VerticalAlignment="Center" FontWeight="Bold"/>
                        </StackPanel>
                        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="{Binding StatusText}" VerticalAlignment="Center" Opacity="0.7" Margin="0,0,15,0"/>
                            <TextBlock Text="{Binding AppVersion, StringFormat='v{0}'}" VerticalAlignment="Center" Opacity="0.5" FontSize="11"/>
                        </StackPanel>
                    </Grid>
                </Grid>
            </TabItem>

            <!-- ═══════════════════════════ PROFILES MANAGEMENT ════════════════════════ -->
            <TabItem>
                <TabItem.Header>
                    <StackPanel>
                        <materialDesign:PackIcon Kind="AccountMultiple" HorizontalAlignment="Center" Width="24" Height="24"/>
                        <TextBlock Text="Profiles" HorizontalAlignment="Center" FontSize="10"/>
                    </StackPanel>
                </TabItem.Header>
                <Grid Margin="20">
                    
                    <!-- ── PROFILE LIST VIEW ── -->
                    <Grid Visibility="{Binding IsProfileListViewVisible, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        
                        <DockPanel Grid.Row="0" Margin="0,0,0,20">
                            <TextBlock Text="PROFILE MANAGEMENT" Style="{StaticResource MaterialDesignHeadline5TextBlock}" VerticalAlignment="Center"/>
                            <Button Command="{Binding NavigateToCreateCommand}" HorizontalAlignment="Right"
                                    Style="{StaticResource MaterialDesignRaisedButton}" Height="40" Padding="16,0"
                                    materialDesign:ButtonAssist.CornerRadius="20">
                                <StackPanel Orientation="Horizontal">
                                    <materialDesign:PackIcon Kind="Plus" Width="20" Height="20" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                    <TextBlock Text="CREATE NEW PROFILE" VerticalAlignment="Center" FontWeight="SemiBold"/>
                                </StackPanel>
                            </Button>
                        </DockPanel>

                        <ListBox Grid.Row="1" ItemsSource="{Binding ProfilesList}" HorizontalContentAlignment="Stretch" BorderThickness="0" Background="Transparent" ScrollViewer.VerticalScrollBarVisibility="Auto">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <materialDesign:Card Padding="15" Margin="0,5,0,10" materialDesign:ElevationAssist.Elevation="Dp1" UniformCornerRadius="6">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/> <!-- Active Switch -->
                                                <ColumnDefinition Width="Auto"/> <!-- Preview Switch -->
                                                <ColumnDefinition Width="Auto"/> <!-- Connection Status -->
                                                <ColumnDefinition Width="Auto"/> <!-- Actions -->
                                            </Grid.ColumnDefinitions>
                                            
                                            <!-- Info Column -->
                                            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding Name}" FontWeight="Bold" FontSize="16"/>
                                                <TextBlock Text="{Binding Profile.ApiBaseUrl}" FontSize="12" Opacity="0.5" Margin="0,2,0,0"/>
                                            </StackPanel>

                                            <!-- Toggle Enable Switch -->
                                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="20,0">
                                                <TextBlock Text="Active" VerticalAlignment="Center" Opacity="0.6" Margin="0,0,8,0" FontSize="12"/>
                                                <ToggleButton IsChecked="{Binding IsEnabled}" 
                                                              Command="{Binding DataContext.ToggleProfileEnabledCommand, RelativeSource={RelativeSource AncestorType=Window}}" 
                                                              CommandParameter="{Binding}"
                                                              Style="{StaticResource MaterialDesignSwitchToggleButton}"/>
                                            </StackPanel>

                                            <!-- Toggle Print Preview Switch -->
                                            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="20,0">
                                                <TextBlock Text="Preview" VerticalAlignment="Center" Opacity="0.6" Margin="0,0,8,0" FontSize="12"/>
                                                <ToggleButton IsChecked="{Binding ShowPrintPreview}" 
                                                              Command="{Binding DataContext.ToggleProfileShowPrintPreviewCommand, RelativeSource={RelativeSource AncestorType=Window}}" 
                                                              CommandParameter="{Binding}"
                                                              Style="{StaticResource MaterialDesignSwitchToggleButton}"/>
                                            </StackPanel>

                                            <!-- Connection Status -->
                                            <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center" Margin="10,0,20,0" Width="130">
                                                <materialDesign:PackIcon Kind="AccessPointNetwork" VerticalAlignment="Center" Foreground="{DynamicResource PrimaryHueMidBrush}" Margin="0,0,5,0"/>
                                                <TextBlock Text="{Binding MqttStatus}" VerticalAlignment="Center" FontWeight="Bold"/>
                                            </StackPanel>

                                            <!-- Edit & Delete Buttons -->
                                            <StackPanel Grid.Column="4" Orientation="Horizontal" VerticalAlignment="Center">
                                                <Button Content="EDIT" Command="{Binding DataContext.NavigateToEditCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}" Style="{StaticResource MaterialDesignFlatButton}" Foreground="{DynamicResource PrimaryHueMidBrush}" Margin="0,0,10,0"/>
                                                <Button Content="DELETE" Command="{Binding DataContext.DeleteProfileCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}" Style="{StaticResource MaterialDesignFlatButton}" Foreground="Crimson"/>
                                            </StackPanel>
                                        </Grid>
                                    </materialDesign:Card>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </Grid>

                    <!-- ── CREATE/EDIT PROFILE FORM ── -->
                    <Grid Visibility="{Binding IsProfileFormViewVisible, Converter={StaticResource BooleanToVisibilityConverter}}" Margin="20">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/> <!-- Header: Title & Save/Cancel buttons -->
                            <RowDefinition Height="Auto"/> <!-- Profile Name & Preview toggle -->
                            <RowDefinition Height="*"/>    <!-- Two-Column Layout -->
                        </Grid.RowDefinitions>

                        <!-- Row 0: Header (Top Right Save/Cancel Buttons) -->
                        <Grid Grid.Row="0" Margin="0,0,0,20">
                            <TextBlock Text="{Binding FormTitle}" Style="{StaticResource MaterialDesignHeadline5TextBlock}" VerticalAlignment="Center" HorizontalAlignment="Left"/>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                <Button Content="CANCEL" Command="{Binding NavigateBackCommand}" Style="{StaticResource MaterialDesignOutlinedButton}" Width="120" Margin="0,0,15,0" Height="40" materialDesign:ButtonAssist.CornerRadius="20"/>
                                <Button Content="SAVE PROFILE" Command="{Binding SaveProfileCommand}" Style="{StaticResource MaterialDesignRaisedButton}" Width="150" Height="40" materialDesign:ButtonAssist.CornerRadius="20"/>
                            </StackPanel>
                        </Grid>

                        <!-- Row 1: Profile Name & Behaviour toggles -->
                        <Grid Grid.Row="1" Margin="0,0,0,25">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBox Grid.Column="0" materialDesign:HintAssist.Hint="Profile Name"
                                     Text="{Binding EditingProfileName, UpdateSourceTrigger=PropertyChanged}"
                                     Style="{StaticResource MaterialDesignOutlinedTextBox}"/>
                            <!-- Show Print Preview toggle -->
                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="25,0,0,0">
                                <TextBlock Text="Show Print Preview:" VerticalAlignment="Center" FontWeight="Bold" Margin="0,0,15,0"/>
                                <ToggleButton IsChecked="{Binding EditingShowPrintPreview}" Style="{StaticResource MaterialDesignSwitchToggleButton}" ToolTip="Show a preview window before printing" />
                            </StackPanel>
                            <!-- Delete Temp File toggle -->
                            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="25,0,0,0">
                                <TextBlock Text="Delete Temp File:" VerticalAlignment="Center" FontWeight="Bold" Margin="0,0,15,0"/>
                                <ToggleButton IsChecked="{Binding EditingDeleteTempFileAfterPrint}" Style="{StaticResource MaterialDesignSwitchToggleButton}"
                                             ToolTip="When ON (default), the temporary PDF is deleted after printing. Turn OFF to keep the file on disk." />
                            </StackPanel>
                        </Grid>

                        <!-- Row 2: Two-Column Form -->
                        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="40"/> <!-- Spacing column -->
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <!-- Left Column: MQTT Configuration -->
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="MQTT CONFIGURATION" Style="{StaticResource MaterialDesignHeadline6TextBlock}" Margin="0,0,0,15" Foreground="{DynamicResource PrimaryHueMidBrush}"/>

                                    <TextBox materialDesign:HintAssist.Hint="Broker URL (e.g. broker.hivemq.com)"
                                             Text="{Binding MqttBroker, UpdateSourceTrigger=PropertyChanged}"
                                             Style="{StaticResource MaterialDesignOutlinedTextBox}" Margin="0,0,0,15"/>

                                    <TextBox materialDesign:HintAssist.Hint="Username"
                                             Text="{Binding MqttUsername, UpdateSourceTrigger=PropertyChanged}"
                                             Style="{StaticResource MaterialDesignOutlinedTextBox}" Margin="0,0,0,15"/>

                                    <PasswordBox materialDesign:HintAssist.Hint="Password"
                                                 local:PasswordHelper.Attach="True"
                                                 local:PasswordHelper.Password="{Binding MqttPassword, Mode=TwoWay}"
                                                 Style="{StaticResource MaterialDesignOutlinedPasswordBox}" Margin="0,0,0,15"/>

                                    <TextBox materialDesign:HintAssist.Hint="Topic (fallback, overridden if authenticated)"
                                             Text="{Binding MqttTopic, UpdateSourceTrigger=PropertyChanged}"
                                             Style="{StaticResource MaterialDesignOutlinedTextBox}" Margin="0,0,0,15"/>

                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,15">
                                        <TextBox materialDesign:HintAssist.Hint="Reconnect Interval"
                                                 Text="{Binding ReconnectIntervalSeconds, UpdateSourceTrigger=PropertyChanged}"
                                                 Width="150"
                                                 Style="{StaticResource MaterialDesignOutlinedTextBox}" Margin="0,0,10,0"/>
                                        <TextBlock Text="Seconds" VerticalAlignment="Center" Opacity="0.6"/>
                                    </StackPanel>

                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,20">
                                        <Button Content="TEST MQTT" Command="{Binding TestMqttConnectionCommand}" Style="{StaticResource MaterialDesignOutlinedButton}" Width="120" Margin="0,0,15,0"/>
                                        <TextBlock Text="{Binding MqttTestResult}" VerticalAlignment="Center" FontWeight="Bold"/>
                                    </StackPanel>
                                </StackPanel>

                                <!-- Right Column: API Configuration -->
                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="API CONFIGURATION" Style="{StaticResource MaterialDesignHeadline6TextBlock}" Margin="0,0,0,15" Foreground="{DynamicResource PrimaryHueMidBrush}"/>
                                    
                                    <TextBox materialDesign:HintAssist.Hint="API Base URL (e.g. https://api.example.com)"
                                             Text="{Binding ApiBaseUrl, UpdateSourceTrigger=PropertyChanged}"
                                             Style="{StaticResource MaterialDesignOutlinedTextBox}" Margin="0,0,0,15"/>

                                    <TextBox materialDesign:HintAssist.Hint="Device Account ID"
                                             Text="{Binding DeviceAccountId, UpdateSourceTrigger=PropertyChanged}"
                                             Style="{StaticResource MaterialDesignOutlinedTextBox}" Margin="0,0,0,15"/>

                                    <PasswordBox materialDesign:HintAssist.Hint="API Secret"
                                                 local:PasswordHelper.Attach="True"
                                                 local:PasswordHelper.Password="{Binding ApiSecret, Mode=TwoWay}"
                                                 Style="{StaticResource MaterialDesignOutlinedPasswordBox}" Margin="0,0,0,15"/>

                                    <TextBox materialDesign:HintAssist.Hint="Device GUID (read-only)"
                                             Text="{Binding DeviceGuid}"
                                             IsReadOnly="True"
                                             Style="{StaticResource MaterialDesignOutlinedTextBox}" Margin="0,0,0,15"/>

                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,20">
                                        <Button Content="TEST API" Command="{Binding TestApiConnectionCommand}" Style="{StaticResource MaterialDesignOutlinedButton}" Width="120" Margin="0,0,15,0"/>
                                        <TextBlock Text="{Binding ApiTestResult}" VerticalAlignment="Center" FontWeight="Bold"/>
                                    </StackPanel>

                                    <!-- ── Print Margin ─────────────────────────────── -->
                                    <TextBlock Text="PRINT MARGIN" Style="{StaticResource MaterialDesignHeadline6TextBlock}" Margin="0,10,0,8" Foreground="{DynamicResource PrimaryHueMidBrush}"/>
                                    <TextBlock Text="Controls how margins are applied when printing PDF documents." FontSize="11" Opacity="0.6" TextWrapping="Wrap" Margin="0,0,0,12"/>

                                    <TextBlock Text="Margin Mode" FontWeight="SemiBold" Margin="0,0,0,5"/>
                                    <ComboBox SelectedItem="{Binding EditingMarginMode}"
                                              ItemsSource="{Binding Source={StaticResource MarginModeValues}}"
                                              Style="{StaticResource MaterialDesignOutlinedComboBox}" Margin="0,0,0,12"/>

                                    <!-- Custom margin fields — visible only when Custom is selected -->
                                    <StackPanel Visibility="{Binding IsCustomMarginVisible, Converter={StaticResource BooleanToVisibilityConverter}}">
                                        <TextBlock Text="Custom Margins (hundredths of an inch)" FontWeight="SemiBold" Margin="0,0,0,8"/>
                                        <Grid Margin="0,0,0,5">
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                            </Grid.RowDefinitions>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="10"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBox Grid.Row="0" Grid.Column="0" materialDesign:HintAssist.Hint="Top"
                                                     Text="{Binding EditingMarginTop, UpdateSourceTrigger=PropertyChanged}"
                                                     Style="{StaticResource MaterialDesignOutlinedTextBox}" Margin="0,0,0,8"/>
                                            <TextBox Grid.Row="0" Grid.Column="2" materialDesign:HintAssist.Hint="Bottom"
                                                     Text="{Binding EditingMarginBottom, UpdateSourceTrigger=PropertyChanged}"
                                                     Style="{StaticResource MaterialDesignOutlinedTextBox}" Margin="0,0,0,8"/>
                                            <TextBox Grid.Row="1" Grid.Column="0" materialDesign:HintAssist.Hint="Left"
                                                     Text="{Binding EditingMarginLeft, UpdateSourceTrigger=PropertyChanged}"
                                                     Style="{StaticResource MaterialDesignOutlinedTextBox}"/>
                                            <TextBox Grid.Row="1" Grid.Column="2" materialDesign:HintAssist.Hint="Right"
                                                     Text="{Binding EditingMarginRight, UpdateSourceTrigger=PropertyChanged}"
                                                     Style="{StaticResource MaterialDesignOutlinedTextBox}"/>
                                        </Grid>
                                        <TextBlock Text="100 = 1 inch. e.g. 50 = 0.5 inch minimum margin." FontSize="11" Opacity="0.5" TextWrapping="Wrap" Margin="0,4,0,0"/>
                                    </StackPanel>
                                </StackPanel>
                            </Grid>
                        </ScrollViewer>
                    </Grid>
                </Grid>
            </TabItem>

            <!-- ═══════════════════════════ ABOUT ═══════════════════════════ -->
            <!-- This tab is last so it sits at the bottom of the nav rail.   -->
            <TabItem x:Name="AboutTabItem">
                <TabItem.Header>
                    <StackPanel ToolTip="About">
                        <materialDesign:PackIcon Kind="InformationOutline" HorizontalAlignment="Center" Width="24" Height="24"/>
                        <TextBlock Text="About" HorizontalAlignment="Center" FontSize="10"/>
                    </StackPanel>
                </TabItem.Header>
                <Grid/>
            </TabItem>

        </TabControl>

        <!-- Notification Snackbar -->
        <materialDesign:Snackbar MessageQueue="{Binding MessageQueue}" VerticalAlignment="Bottom"/>
    </Grid>
</Window>
