<Window x:Class="PrintDesktopClient.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        xmlns:tb="clr-namespace:H.NotifyIcon;assembly=H.NotifyIcon.Wpf"
        xmlns:local="clr-namespace:PrintDesktopClient"
        xmlns:vm="clr-namespace:PrintDesktopClient.ViewModels"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance Type=vm:MainViewModel}"
        Title="Auto-Print Agent" Height="700" Width="950"
        TextElement.Foreground="{DynamicResource MaterialDesignBody}"
        TextElement.FontWeight="Regular"
        TextElement.FontSize="14"
        TextOptions.TextFormattingMode="Ideal"
        TextOptions.TextRenderingMode="Auto"
        Background="{DynamicResource MaterialDesignPaper}"
        FontFamily="{materialDesign:MaterialDesignFont}"
        StateChanged="Window_StateChanged">
    <Grid>
        <!-- Tray Icon -->
        <tb:TaskbarIcon x:Name="MyNotifyIcon"
                        Visibility="Visible"
                        ToolTipText="Auto-Print Agent"
                        MenuActivation="LeftOrRightClick"
                        TrayMouseDoubleClick="MyNotifyIcon_TrayMouseDoubleClick">
            <tb:TaskbarIcon.ContextMenu>
                <ContextMenu>
                    <MenuItem Header="Open Dashboard" Click="Open_Click">
                        <MenuItem.Icon>
                            <materialDesign:PackIcon Kind="WindowMaximize" />
                        </MenuItem.Icon>
                    </MenuItem>
                    <Separator />
                    <MenuItem Header="Exit" Click="Exit_Click">
                        <MenuItem.Icon>
                            <materialDesign:PackIcon Kind="ExitToApp" />
                        </MenuItem.Icon>
                    </MenuItem>
                </ContextMenu>
            </tb:TaskbarIcon.ContextMenu>
        </tb:TaskbarIcon>

        <TabControl Style="{StaticResource MaterialDesignNavigationRailTabControl}" TabStripPlacement="Left">
            <!-- DASHBOARD TAB -->
            <TabItem>
                <TabItem.Header>
                    <StackPanel Width="Auto" Height="Auto">
                        <materialDesign:PackIcon Kind="ViewDashboard" HorizontalAlignment="Center" Width="24" Height="24"/>
                        <TextBlock Text="Dashboard" HorizontalAlignment="Center" FontSize="10"/>
                    </StackPanel>
                </TabItem.Header>
                <Grid Margin="20">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="200"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Printer Selection -->
                    <materialDesign:Card Grid.Row="0" Padding="15" Margin="0,0,0,15" materialDesign:ElevationAssist.Elevation="Dp2">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="Printer" VerticalAlignment="Center" Margin="0,0,10,0" Width="24" Height="24" Foreground="{DynamicResource PrimaryHueMidBrush}"/>
                            <TextBlock Text="Target Printer:" VerticalAlignment="Center" FontWeight="Bold" Margin="0,0,15,0"/>
                            <ComboBox ItemsSource="{Binding AvailablePrinters}" 
                                      SelectedItem="{Binding SelectedPrinter}" 
                                      materialDesign:HintAssist.Hint="Select a printer"
                                      Width="350" Margin="0,0,15,0"
                                      Style="{StaticResource MaterialDesignOutlinedComboBox}"/>
                            <Button Content="REFRESH" Command="{Binding RefreshPrintersCommand}" Style="{StaticResource MaterialDesignFlatButton}" Foreground="{DynamicResource PrimaryHueMidBrush}"/>
                        </StackPanel>
                    </materialDesign:Card>

                    <!-- Drop Zone -->
                    <materialDesign:Card Grid.Row="1" Margin="0,0,0,15" materialDesign:ElevationAssist.Elevation="Dp1" UniformCornerRadius="8"
                                         AllowDrop="True" Drop="DropZone_Drop">
                        <Border BorderThickness="1" BorderBrush="{DynamicResource PrimaryHueMidBrush}" CornerRadius="8">
                            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                                <materialDesign:PackIcon Kind="CloudUpload" Width="64" Height="64" HorizontalAlignment="Center" Foreground="{DynamicResource PrimaryHueMidBrush}"/>
                                <TextBlock Text="Drag and drop documents here to print" FontSize="20" FontWeight="Light" Margin="0,15,0,5"/>
                                <TextBlock Text="PDF, Image, or Text files are supported" FontSize="14" Opacity="0.6" HorizontalAlignment="Center" Margin="0,0,0,25"/>
                                <Button Content="BROWSE FILES" Command="{Binding BrowseAndPrintCommand}" Style="{StaticResource MaterialDesignRaisedButton}" Width="180" Height="45" materialDesign:ButtonAssist.CornerRadius="22"/>
                            </StackPanel>
                        </Border>
                    </materialDesign:Card>

                    <!-- Logs -->
                    <materialDesign:Card Grid.Row="2" Padding="10" Margin="0,0,0,10" materialDesign:ElevationAssist.Elevation="Dp1">
                        <DockPanel>
                            <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,10">
                                <materialDesign:PackIcon Kind="ViewList" VerticalAlignment="Center" Margin="0,0,8,0" Foreground="{DynamicResource PrimaryHueMidBrush}"/>
                                <TextBlock Text="SYSTEM ACTIVITY LOG" FontWeight="Bold" FontSize="12" Foreground="{DynamicResource PrimaryHueMidBrush}"/>
                            </StackPanel>
                            <ListBox ItemsSource="{Binding Logs}" BorderThickness="0" Background="Transparent">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="0,3">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <materialDesign:PackIcon Kind="ChevronRight" VerticalAlignment="Center" Opacity="0.5" Width="14" Height="14" Margin="0,0,8,0"/>
                                            <TextBlock Grid.Column="1" Text="{Binding}" FontSize="12" FontFamily="Consolas" VerticalAlignment="Center"/>
                                        </Grid>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </DockPanel>
                    </materialDesign:Card>

                    <!-- Status Bar -->
                    <Grid Grid.Row="3" Margin="5,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0" Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="AccessPointNetwork" VerticalAlignment="Center" Margin="0,0,8,0" Foreground="{DynamicResource PrimaryHueMidBrush}"/>
                            <TextBlock Text="MQTT:" VerticalAlignment="Center" Opacity="0.7" Margin="0,0,5,0"/>
                            <TextBlock Text="{Binding MqttStatus}" VerticalAlignment="Center" FontWeight="Bold"/>
                            <Button Command="{Binding ManualConnectCommand}" Margin="10,0,0,0" ToolTip="Manual Connect" Style="{StaticResource MaterialDesignIconButton}" Width="24" Height="24">
                                <materialDesign:PackIcon Kind="Refresh" Width="16" Height="16"/>
                            </Button>
                        </StackPanel>

                        <StackPanel Grid.Column="2" Orientation="Horizontal">
                            <TextBlock Text="{Binding StatusText}" VerticalAlignment="Center" Opacity="0.7"/>
                        </StackPanel>
                    </Grid>
                </Grid>
            </TabItem>

            <!-- SETTINGS TAB -->
            <TabItem>
                <TabItem.Header>
                    <StackPanel Width="Auto" Height="Auto">
                        <materialDesign:PackIcon Kind="Settings" HorizontalAlignment="Center" Width="24" Height="24"/>
                        <TextBlock Text="Settings" HorizontalAlignment="Center" FontSize="10"/>
                    </StackPanel>
                </TabItem.Header>
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <Grid Margin="40,20">
                        <StackPanel MaxWidth="500" HorizontalAlignment="Left">
                            <TextBlock Text="MQTT CONFIGURATION" Style="{StaticResource MaterialDesignHeadline5TextBlock}" Margin="0,0,0,20"/>
                            
                            <TextBox materialDesign:HintAssist.Hint="Broker URL (e.g. mqttserver.test)" 
                                     Text="{Binding MqttBroker, UpdateSourceTrigger=PropertyChanged}" 
                                     Style="{StaticResource MaterialDesignOutlinedTextBox}" Margin="0,0,0,15"/>

                            <TextBox materialDesign:HintAssist.Hint="Username" 
                                     Text="{Binding MqttUsername, UpdateSourceTrigger=PropertyChanged}" 
                                     Style="{StaticResource MaterialDesignOutlinedTextBox}" Margin="0,0,0,15"/>

                            <PasswordBox materialDesign:HintAssist.Hint="Password" 
                                         local:PasswordHelper.Attach="True" 
                                         local:PasswordHelper.Password="{Binding MqttPassword, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                         Style="{StaticResource MaterialDesignOutlinedPasswordBox}" Margin="0,0,0,15"/>

                            <TextBox materialDesign:HintAssist.Hint="Topic" 
                                     Text="{Binding MqttTopic, UpdateSourceTrigger=PropertyChanged}" 
                                     Style="{StaticResource MaterialDesignOutlinedTextBox}" Margin="0,0,0,15"/>

                            <StackPanel Orientation="Horizontal" Margin="0,0,0,30">
                                <TextBox materialDesign:HintAssist.Hint="Reconnect Interval" 
                                         Text="{Binding ReconnectIntervalMinutes, UpdateSourceTrigger=PropertyChanged}" 
                                         Width="150"
                                         Style="{StaticResource MaterialDesignOutlinedTextBox}" Margin="0,0,10,0"/>
                                <TextBlock Text="Minutes" VerticalAlignment="Center" Opacity="0.6"/>
                            </StackPanel>

                            <Button Content="SAVE &amp; APPLY SETTINGS" 
                                    Command="{Binding SaveMqttSettingsCommand}"
                                    Style="{StaticResource MaterialDesignRaisedButton}" 
                                    Height="45" materialDesign:ButtonAssist.CornerRadius="22"/>
                        </StackPanel>
                    </Grid>
                </ScrollViewer>
            </TabItem>
        </TabControl>

        <!-- Notification Snackbar -->
        <materialDesign:Snackbar MessageQueue="{Binding MessageQueue}" VerticalAlignment="Bottom"/>
    </Grid>
</Window>
