<Window x:Class="PrintDesktopClient.AboutWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        Title="About — Print Desktop Client"
        Width="560" Height="680"
        MinWidth="480" MinHeight="500"
        ResizeMode="CanResizeWithGrip"
        WindowStartupLocation="CenterOwner"
        Icon="/Resources/Images/PDC_Icons/favicon.ico"
        TextElement.Foreground="{DynamicResource MaterialDesignBody}"
        TextElement.FontWeight="Regular"
        TextElement.FontSize="14"
        Background="{DynamicResource MaterialDesignPaper}"
        FontFamily="{materialDesign:MaterialDesignFont}">

    <!-- Outer layout: scrollable content + pinned Close button -->
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>   <!-- Scrollable content area -->
            <RowDefinition Height="Auto"/> <!-- Pinned Close button -->
        </Grid.RowDefinitions>

        <!-- ── Scrollable content ────────────────────────────────────────── -->
        <ScrollViewer Grid.Row="0"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled"
                      Padding="0,0,4,0">

            <StackPanel Margin="32,32,32,16">

                <!-- Logo & App Name -->
                <Image Source="/Resources/Images/Logo.png"
                       MaxWidth="240" MaxHeight="100"
                       HorizontalAlignment="Center"
                       Stretch="Uniform"
                       Margin="0,0,0,14"/>
                <TextBlock Text="Print Desktop Client"
                           FontSize="24" FontWeight="Bold"
                           HorizontalAlignment="Center"
                           Foreground="{DynamicResource PrimaryHueMidBrush}"/>
                <TextBlock Text="Auto-Print Agent for nopCommerce"
                           FontSize="12" Opacity="0.55"
                           HorizontalAlignment="Center"
                           Margin="0,5,0,18"/>

                <!-- Version Badge -->
                <Border HorizontalAlignment="Center"
                        Background="{DynamicResource PrimaryHueLightBrush}"
                        CornerRadius="14" Padding="18,6"
                        Margin="0,0,0,24">
                    <TextBlock x:Name="VersionLabel"
                               FontSize="12" FontWeight="SemiBold"
                               Foreground="{DynamicResource PrimaryHueLightForegroundBrush}"/>
                </Border>

                <!-- Divider -->
                <Separator Opacity="0.2" Margin="0,0,0,20"/>

                <!-- About Section -->
                <TextBlock Text="ABOUT THIS APPLICATION"
                           FontSize="10" FontWeight="Bold" Opacity="0.45"
                           Margin="0,0,0,10"/>
                <TextBlock TextWrapping="Wrap" LineHeight="22" Opacity="0.8" FontSize="13"
                           Margin="0,0,0,24">
                    An enterprise-grade, profile-based printing agent that establishes
                    persistent connections to an MQTT broker to receive remote print commands
                    from your nopCommerce store. It downloads document payloads (PDF) from a
                    secure Cloud API and silently routes them to configured local or network
                    printers — with zero data-at-rest. Credentials are protected using
                    Windows DPAPI encryption.
                </TextBlock>

                <!-- Key Features Section -->
                <TextBlock Text="KEY FEATURES"
                           FontSize="10" FontWeight="Bold" Opacity="0.45"
                           Margin="0,0,0,10"/>
                <StackPanel Margin="0,0,0,24">
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,7">
                        <materialDesign:PackIcon Kind="CheckCircleOutline" Width="16" Height="16"
                                                 VerticalAlignment="Center"
                                                 Foreground="{DynamicResource PrimaryHueMidBrush}"
                                                 Margin="0,0,8,0"/>
                        <TextBlock Text="Multi-profile parallel MQTT connections" FontSize="13" Opacity="0.8" VerticalAlignment="Center"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,7">
                        <materialDesign:PackIcon Kind="CheckCircleOutline" Width="16" Height="16"
                                                 VerticalAlignment="Center"
                                                 Foreground="{DynamicResource PrimaryHueMidBrush}"
                                                 Margin="0,0,8,0"/>
                        <TextBlock Text="Zero data-at-rest — PDFs are wiped after printing" FontSize="13" Opacity="0.8" VerticalAlignment="Center"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,7">
                        <materialDesign:PackIcon Kind="CheckCircleOutline" Width="16" Height="16"
                                                 VerticalAlignment="Center"
                                                 Foreground="{DynamicResource PrimaryHueMidBrush}"
                                                 Margin="0,0,8,0"/>
                        <TextBlock Text="DPAPI-encrypted credential storage" FontSize="13" Opacity="0.8" VerticalAlignment="Center"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,7">
                        <materialDesign:PackIcon Kind="CheckCircleOutline" Width="16" Height="16"
                                                 VerticalAlignment="Center"
                                                 Foreground="{DynamicResource PrimaryHueMidBrush}"
                                                 Margin="0,0,8,0"/>
                        <TextBlock Text="Silent boot &amp; system tray integration" FontSize="13" Opacity="0.8" VerticalAlignment="Center"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <materialDesign:PackIcon Kind="CheckCircleOutline" Width="16" Height="16"
                                                 VerticalAlignment="Center"
                                                 Foreground="{DynamicResource PrimaryHueMidBrush}"
                                                 Margin="0,0,8,0"/>
                        <TextBlock Text="Remote revocation (self-wipe) support" FontSize="13" Opacity="0.8" VerticalAlignment="Center"/>
                    </StackPanel>
                </StackPanel>

                <!-- Divider -->
                <Separator Opacity="0.2" Margin="0,0,0,20"/>

                <!-- Developer Card -->
                <TextBlock Text="DEVELOPER"
                           FontSize="10" FontWeight="Bold" Opacity="0.45"
                           Margin="0,0,0,10"/>
                <materialDesign:Card Padding="18" Margin="0,0,0,20"
                                     materialDesign:ElevationAssist.Elevation="Dp2"
                                     UniformCornerRadius="10">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- Avatar -->
                        <Border Grid.Column="0" Width="56" Height="56" CornerRadius="28"
                                Background="{DynamicResource PrimaryHueMidBrush}"
                                VerticalAlignment="Center" Margin="0,0,18,0">
                            <materialDesign:PackIcon Kind="AccountCircle"
                                                     Width="34" Height="34"
                                                     HorizontalAlignment="Center"
                                                     VerticalAlignment="Center"
                                                     Foreground="White"/>
                        </Border>

                        <!-- Info -->
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock Text="Fuad Hasan"
                                       FontWeight="Bold" FontSize="17"
                                       Margin="0,0,0,2"/>
                            <TextBlock Text="Developer &amp; Maintainer"
                                       Opacity="0.5" FontSize="12"
                                       Margin="0,0,0,10"/>

                            <!-- Email -->
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                <materialDesign:PackIcon Kind="EmailOutline" Width="15" Height="15"
                                                         VerticalAlignment="Center"
                                                         Opacity="0.55" Margin="0,0,7,0"/>
                                <TextBlock FontSize="13" VerticalAlignment="Center">
                                    <Hyperlink NavigateUri="mailto:fhassanwasi@gmail.com"
                                               RequestNavigate="Hyperlink_RequestNavigate">
                                        fhassanwasi@gmail.com
                                    </Hyperlink>
                                </TextBlock>
                            </StackPanel>

                            <!-- GitHub -->
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="Github" Width="15" Height="15"
                                                         VerticalAlignment="Center"
                                                         Opacity="0.55" Margin="0,0,7,0"/>
                                <TextBlock FontSize="13" VerticalAlignment="Center">
                                    <Hyperlink NavigateUri="https://github.com/fuadwasi"
                                               RequestNavigate="Hyperlink_RequestNavigate">
                                        github.com/fuadwasi
                                    </Hyperlink>
                                </TextBlock>
                            </StackPanel>
                        </StackPanel>
                    </Grid>
                </materialDesign:Card>

                <!-- Copyright -->
                <TextBlock Text="© 2026 Fuad Hasan. All rights reserved."
                           FontSize="11" Opacity="0.35"
                           HorizontalAlignment="Center"
                           Margin="0,16,0,0"/>

            </StackPanel>
        </ScrollViewer>

        <!-- ── Pinned Close button (always visible at the bottom) ─────── -->
        <Border Grid.Row="1"
                BorderThickness="0,1,0,0"
                BorderBrush="{DynamicResource MaterialDesignDivider}"
                Padding="0,12">
            <Button Content="CLOSE"
                    HorizontalAlignment="Center"
                    Width="140" Height="40"
                    Click="CloseButton_Click"
                    Style="{StaticResource MaterialDesignRaisedButton}"
                    materialDesign:ButtonAssist.CornerRadius="20"/>
        </Border>
    </Grid>
</Window>
