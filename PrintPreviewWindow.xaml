<Window x:Class="PrintDesktopClient.PrintPreviewWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        Title="Print Preview" Height="800" Width="1000"
        WindowStartupLocation="CenterScreen"
        Icon="/Resources/Images/PDC_Icons/favicon.ico"
        TextElement.Foreground="{DynamicResource MaterialDesignBody}"
        Background="{DynamicResource MaterialDesignPaper}"
        FontFamily="{materialDesign:MaterialDesignFont}">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <materialDesign:ColorZone Grid.Row="0" Mode="PrimaryMid" Padding="16" materialDesign:ElevationAssist.Elevation="Dp4">
            <StackPanel Orientation="Horizontal">
                <materialDesign:PackIcon Kind="Eye" Width="24" Height="24" VerticalAlignment="Center" Margin="0,0,10,0"/>
                <TextBlock Text="Document Preview &amp; Print Settings" VerticalAlignment="Center" FontSize="18" FontWeight="Medium"/>
            </StackPanel>
        </materialDesign:ColorZone>

        <!-- Main Content (Preview + Settings) -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="350"/>
            </Grid.ColumnDefinitions>

            <!-- PrintPreviewControl Host -->
            <Grid Grid.Column="0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <!-- Zoom toolbar -->
                <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="10,10,10,0" HorizontalAlignment="Right">
                    <TextBlock Text="Zoom: " VerticalAlignment="Center" Margin="0,0,5,0"/>
                    <ComboBox x:Name="ZoomCombo" Width="100" SelectionChanged="ZoomCombo_SelectionChanged" Style="{StaticResource MaterialDesignOutlinedComboBox}">
                        <ComboBoxItem Content="Auto" IsSelected="True" Tag="Auto"/>
                        <ComboBoxItem Content="100%" Tag="1.0"/>
                        <ComboBoxItem Content="150%" Tag="1.5"/>
                        <ComboBoxItem Content="200%" Tag="2.0"/>
                    </ComboBox>
                </StackPanel>
                <WindowsFormsHost x:Name="PreviewHost" Grid.Row="1" Margin="10"/>
            </Grid>

            <!-- Settings Panel -->
            <Border Grid.Column="1" Background="{DynamicResource MaterialDesignCardBackground}" BorderBrush="{DynamicResource MaterialDesignDivider}" BorderThickness="1,0,0,0">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="20">
                        <TextBlock Text="Printer Options" Style="{StaticResource MaterialDesignHeadline6TextBlock}" Margin="0,0,0,20"/>

                        <!-- Printer Selection -->
                        <TextBlock Text="Target Printer" FontWeight="SemiBold" Margin="0,0,0,5"/>
                        <ComboBox x:Name="PrinterCombo" SelectionChanged="Setting_Changed" Style="{StaticResource MaterialDesignOutlinedComboBox}" Margin="0,0,0,20"/>

                        <!-- Orientation -->
                        <TextBlock Text="Orientation" FontWeight="SemiBold" Margin="0,0,0,5"/>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,20">
                            <RadioButton x:Name="RadioPortrait" Content="Portrait" IsChecked="True" Checked="Setting_Changed" Margin="0,0,15,0"/>
                            <RadioButton x:Name="RadioLandscape" Content="Landscape" Checked="Setting_Changed"/>
                        </StackPanel>

                        <!-- Scaling Mode -->
                        <TextBlock Text="Scaling" FontWeight="SemiBold" Margin="0,0,0,5"/>
                        <ComboBox x:Name="ScaleCombo" SelectionChanged="Setting_Changed" Style="{StaticResource MaterialDesignOutlinedComboBox}" Margin="0,0,0,10">
                            <ComboBoxItem Content="Shrink to Margin" IsSelected="True" Tag="ShrinkToMargin"/>
                            <ComboBoxItem Content="Actual Size (Cut Margin)" Tag="CutMargin"/>
                            <ComboBoxItem Content="Custom Scale" Tag="Custom"/>
                        </ComboBox>

                        <!-- Custom Scale Input Panel -->
                        <StackPanel x:Name="CustomScalePanel" Visibility="Collapsed" Margin="0,0,0,20">
                            <TextBlock Text="Scale Value (%)" FontWeight="SemiBold" Margin="0,0,0,5"/>
                            <TextBox x:Name="CustomScaleInput" Text="100" TextChanged="Setting_TextChanged" Style="{StaticResource MaterialDesignOutlinedTextBox}"/>
                        </StackPanel>

                        <!-- Margins -->
                        <TextBlock Text="Margins (Hundredths of an inch)" FontWeight="SemiBold" Margin="0,0,0,10"/>
                        <Grid Margin="0,0,0,20">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            
                            <TextBox x:Name="MarginTop" TextChanged="Setting_TextChanged" materialDesign:HintAssist.Hint="Top" Text="0" Style="{StaticResource MaterialDesignOutlinedTextBox}" Margin="0,0,10,10" Grid.Row="0" Grid.Column="0"/>
                            <TextBox x:Name="MarginBottom" TextChanged="Setting_TextChanged" materialDesign:HintAssist.Hint="Bottom" Text="0" Style="{StaticResource MaterialDesignOutlinedTextBox}" Margin="0,0,0,10" Grid.Row="0" Grid.Column="1"/>
                            <TextBox x:Name="MarginLeft" TextChanged="Setting_TextChanged" materialDesign:HintAssist.Hint="Left" Text="0" Style="{StaticResource MaterialDesignOutlinedTextBox}" Margin="0,0,10,0" Grid.Row="1" Grid.Column="0"/>
                            <TextBox x:Name="MarginRight" TextChanged="Setting_TextChanged" materialDesign:HintAssist.Hint="Right" Text="0" Style="{StaticResource MaterialDesignOutlinedTextBox}" Grid.Row="1" Grid.Column="1"/>
                        </Grid>

                        <TextBlock Text="Settings apply only to this print job." FontStyle="Italic" Opacity="0.6" TextWrapping="Wrap"/>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>

        <!-- Footer Buttons -->
        <Border Grid.Row="2" Background="{DynamicResource MaterialDesignCardBackground}" Padding="16" BorderBrush="{DynamicResource MaterialDesignDivider}" BorderThickness="0,1,0,0">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="CANCEL" Click="Cancel_Click" Style="{StaticResource MaterialDesignOutlinedButton}" Margin="0,0,10,0" Width="100"/>
                <Button Content="PRINT" Click="Print_Click" Style="{StaticResource MaterialDesignRaisedButton}" Width="100"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>
